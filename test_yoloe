from ultralytics import YOLOE
import cv2
import time
from collections import defaultdict, deque, Counter


# ============================================================
# 1. 설정
# ============================================================

MODEL_PATH = "yoloe_custom.pt"

# USB 카메라
# 0 = 노트북 웹캠
# 1 = USB 카메라
CAMERA_INDEX = 1

# YOLOE
CONF_THRESHOLD = 0.25

# 416 → 320
# FPS 향상을 위한 설정
IMAGE_SIZE = 320

# 카메라 수평 시야각
HORIZONTAL_FOV = 120.0

# 최근 몇 프레임의 클래스 결과를 기억할지
HISTORY_SIZE = 5

# Tracking 방식
TRACKER_CONFIG = "bytetrack.yaml"


# ============================================================
# 2. YOLOE 모델 로드
# ============================================================

print("YOLOE 모델 로딩 중...")

model = YOLOE(
    MODEL_PATH
)

print("YOLOE 모델 로딩 완료")


# ============================================================
# 3. USB 카메라 연결
# ============================================================

print(
    f"USB 카메라 연결: "
    f"index={CAMERA_INDEX}"
)

cap = cv2.VideoCapture(
    CAMERA_INDEX
)


if not cap.isOpened():

    print(
        "❌ 카메라를 열 수 없습니다."
    )

    exit()


# ============================================================
# 4. 카메라 해상도 설정
# ============================================================

cap.set(

    cv2.CAP_PROP_FRAME_WIDTH,

    640

)

cap.set(

    cv2.CAP_PROP_FRAME_HEIGHT,

    480

)


# ============================================================
# 5. 카메라 실제 해상도 확인
# ============================================================

frame_width = int(

    cap.get(

        cv2.CAP_PROP_FRAME_WIDTH

    )

)

frame_height = int(

    cap.get(

        cv2.CAP_PROP_FRAME_HEIGHT

    )

)


print(

    f"카메라 해상도: "
    f"{frame_width} x "
    f"{frame_height}"

)


# ============================================================
# 6. 객체별 Tracking 기록
#
# object_history[ID]
#
# 같은 객체의 최근 데이터를 저장
# ============================================================

object_history = defaultdict(

    lambda: {

        "classes": deque(

            maxlen=HISTORY_SIZE

        ),

        "confidences": deque(

            maxlen=HISTORY_SIZE

        )

    }

)


# ============================================================
# 7. 수평 방향각 계산
# ============================================================

def get_horizontal_angle(

    center_x,

    frame_width

):

    normalized_x = (

        center_x -

        frame_width / 2

    ) / (

        frame_width / 2

    )


    angle = (

        normalized_x *

        (
            HORIZONTAL_FOV /
            2
        )

    )


    return angle


# ============================================================
# 8. 방향 판단
# ============================================================

def get_direction(

    angle

):

    if angle < -20:

        return "LEFT"


    elif angle > 20:

        return "RIGHT"


    else:

        return "CENTER"


# ============================================================
# 9. 화면 점유율 계산
# ============================================================

def get_area_ratio(

    x1,

    y1,

    x2,

    y2,

    frame_width,

    frame_height

):

    box_width = (

        x2 -

        x1

    )


    box_height = (

        y2 -

        y1

    )


    box_area = (

        box_width *

        box_height

    )


    frame_area = (

        frame_width *

        frame_height

    )


    if frame_area <= 0:

        return 0.0


    return (

        box_area /

        frame_area

    )


# ============================================================
# 10. 화면 안쪽에 텍스트 표시
# ============================================================

def draw_label(

    frame,

    text,

    x,

    y

):

    font = (

        cv2.FONT_HERSHEY_SIMPLEX

    )


    scale = 0.55


    thickness = 2


    (
        text_width,

        text_height

    ), baseline = (

        cv2.getTextSize(

            text,

            font,

            scale,

            thickness

        )

    )


    # --------------------------------------------------------
    # 오른쪽 화면 밖 방지
    # --------------------------------------------------------

    if (

        x +

        text_width

        >

        frame.shape[1]

    ):

        x = (

            frame.shape[1]

            -

            text_width

            -

            5

        )


    # --------------------------------------------------------
    # 왼쪽 화면 밖 방지
    # --------------------------------------------------------

    if x < 5:

        x = 5


    # --------------------------------------------------------
    # 화면 위쪽 밖 방지
    # --------------------------------------------------------

    if (

        y -

        text_height

        < 0

    ):

        y += (

            text_height

            +

            10

        )


    # --------------------------------------------------------
    # 화면 아래쪽 밖 방지
    # --------------------------------------------------------

    if (

        y +

        baseline

        >

        frame.shape[0]

    ):

        y = (

            frame.shape[0]

            -

            baseline

            -

            5

        )


    # --------------------------------------------------------
    # 텍스트 배경
    # --------------------------------------------------------

    cv2.rectangle(

        frame,

        (

            x - 3,

            y -

            text_height -

            3

        ),

        (

            x +

            text_width +

            3,

            y +

            baseline +

            3

        ),

        (

            0,

            0,

            0

        ),

        -1

    )


    # --------------------------------------------------------
    # 텍스트
    # --------------------------------------------------------

    cv2.putText(

        frame,

        text,

        (

            x,

            y

        ),

        font,

        scale,

        (

            0,

            255,

            0

        ),

        thickness,

        cv2.LINE_AA

    )


# ============================================================
# 11. FPS 변수
# ============================================================

prev_time = time.time()


# ============================================================
# 12. 메인 루프
# ============================================================

while True:


    # ========================================================
    # 카메라 프레임
    # ========================================================

    ret, frame = (

        cap.read()

    )


    if not ret:

        print(

            "❌ 카메라 프레임을 "
            "읽을 수 없습니다."

        )

        break


    # ========================================================
    # 실제 프레임 크기
    # ========================================================

    frame_height, frame_width = (

        frame.shape[:2]

    )


    # ========================================================
    # YOLOE + Tracking
    #
    # imgsz = 320
    #
    # ByteTrack 사용
    #
    # persist=True
    # → 같은 객체 ID 유지
    # ========================================================

    results = model.track(

        source=frame,

        conf=CONF_THRESHOLD,

        imgsz=IMAGE_SIZE,

        persist=True,

        tracker=TRACKER_CONFIG,

        verbose=False

    )


    result = results[0]


    # ========================================================
    # Tracking ID가 없는 경우
    # ========================================================

    if (

        result.boxes.id is None

    ):

        draw_label(

            frame,

            "No Objects",

            10,

            30

        )


        # FPS 계산

        current_time = (

            time.time()

        )


        fps = (

            1 /

            max(

                current_time -

                prev_time,

                0.0001

            )

        )


        prev_time = (

            current_time

        )


        draw_label(

            frame,

            f"FPS: {fps:.1f}",

            10,

            60

        )


        cv2.imshow(

            "YOLOE Tracking",

            frame

        )


        if (

            cv2.waitKey(1)

            &

            0xFF

        ) == ord("q"):

            break


        continue


    # ========================================================
    # 객체 처리
    # ========================================================

    for box, track_id in zip(

        result.boxes,

        result.boxes.id

    ):


        # ====================================================
        # Tracking ID
        # ====================================================

        object_id = int(

            track_id

        )


        # ====================================================
        # 클래스 ID
        # ====================================================

        cls_id = int(

            box.cls[0]

        )


        # ====================================================
        # 클래스 이름
        # ====================================================

        class_name = (

            result.names[

                cls_id

            ]

        )


        # ====================================================
        # Confidence
        # ====================================================

        confidence = float(

            box.conf[0]

        )


        # ====================================================
        # Bounding Box
        # ====================================================

        x1, y1, x2, y2 = map(

            int,

            box.xyxy[0].tolist()

        )


        # ====================================================
        # 좌표 보정
        # ====================================================

        x1 = max(

            0,

            min(

                x1,

                frame_width - 1

            )

        )


        y1 = max(

            0,

            min(

                y1,

                frame_height - 1

            )

        )


        x2 = max(

            0,

            min(

                x2,

                frame_width - 1

            )

        )


        y2 = max(

            0,

            min(

                y2,

                frame_height - 1

            )

        )


        # ====================================================
        # 중심점
        # ====================================================

        center_x = (

            x1 +

            x2

        ) / 2


        # ====================================================
        # 방향각
        # ====================================================

        angle = (

            get_horizontal_angle(

                center_x,

                frame_width

            )

        )


        # ====================================================
        # 방향
        # ====================================================

        direction = (

            get_direction(

                angle

            )

        )


        # ====================================================
        # 화면 점유율
        # ====================================================

        area_ratio = (

            get_area_ratio(

                x1,

                y1,

                x2,

                y2,

                frame_width,

                frame_height

            )

        )


        # ====================================================
        # 최근 클래스 저장
        # ====================================================

        history = (

            object_history[

                object_id

            ]

        )


        history[

            "classes"

        ].append(

            class_name

        )


        history[

            "confidences"

        ].append(

            confidence

        )


        # ====================================================
        # 최근 클래스 투표
        # ====================================================

        class_counter = Counter(

            history[

                "classes"

            ]

        )


        stable_class = (

            class_counter

            .most_common(1)[0][0]

        )


        # ====================================================
        # 평균 Confidence
        # ====================================================

        avg_confidence = (

            sum(

                history[

                    "confidences"

                ]

            )

            /

            len(

                history[

                    "confidences"

                ]

            )

        )


        # ====================================================
        # Bounding Box 표시
        # ====================================================

        cv2.rectangle(

            frame,

            (

                x1,

                y1

            ),

            (

                x2,

                y2

            ),

            (

                0,

                255,

                0

            ),

            2

        )


        # ====================================================
        # 객체 정보
        # ====================================================

        label = (

            f"ID {object_id} | "

            f"{stable_class}"

        )


        draw_label(

            frame,

            label,

            x1,

            y1 - 5

        )


        # ====================================================
        # 상세 정보
        # ====================================================

        info = (

            f"{direction} "

            f"{angle:+.0f}deg "

            f"A:{area_ratio:.2f} "

            f"C:{avg_confidence:.2f}"

        )


        draw_label(

            frame,

            info,

            x1,

            y2 + 20

        )


        # ====================================================
        # 터미널 출력
        # ====================================================

        print(

            f"[ID {object_id}] "

            f"Raw={class_name} | "

            f"Stable={stable_class} | "

            f"Conf={avg_confidence:.2f} | "

            f"Direction={direction} | "

            f"Angle={angle:+.1f}° | "

            f"Area={area_ratio:.2f}"

        )


    # ========================================================
    # 중앙 기준선
    # ========================================================

    cv2.line(

        frame,

        (

            frame_width // 2,

            0

        ),

        (

            frame_width // 2,

            frame_height

        ),

        (

            255,

            0,

            0

        ),

        2

    )


    # ========================================================
    # FPS 계산
    # ========================================================

    current_time = (

        time.time()

    )


    fps = (

        1 /

        max(

            current_time -

            prev_time,

            0.0001

        )

    )


    prev_time = (

        current_time

    )


    # ========================================================
    # FPS 표시
    # ========================================================

    draw_label(

        frame,

        f"FPS: {fps:.1f}",

        10,

        30

    )


    # ========================================================
    # 화면 출력
    # ========================================================

    cv2.imshow(

        "YOLOE Tracking",

        frame

    )


    # ========================================================
    # Q 종료
    # ========================================================

    key = (

        cv2.waitKey(1)

        &

        0xFF

    )


    if key == ord("q"):

        break


# ============================================================
# 13. 종료
# ============================================================

cap.release()

cv2.destroyAllWindows()


print()

print(

    "프로그램 종료"

)
