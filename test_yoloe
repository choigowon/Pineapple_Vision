class OptionalIMU:
    """간단한 시리얼 IMU 어댑터.
    IMU가 없으면 항상 정지/미사용 상태로 동작한다.
    센서 출력 예시: ax,ay,az,gx,gy,gz\n
    실제 IMU 모델에 맞게 parse_line()을 수정해야 한다.
    """
    def __init__(self, port=None, baudrate=115200):
        self.ser = None
        self.moving = False
        self.turning = False
        if port and serial:
            try:
                self.ser = serial.Serial(port, baudrate, timeout=0.02)
                threading.Thread(target=self._reader, daemon=True).start()
                print(f"IMU 연결: {port}")
            except Exception as exc:
                print(f"IMU 연결 실패: {exc}")
        else:
            print("IMU 없이 실행합니다. 카메라 기반 상태 추정만 사용합니다.")

    def parse_line(self, line):
        # 장치별 포맷에 맞게 수정할 부분
        try:
            values = [float(x.strip()) for x in line.split(",")]
            if len(values) >= 6:
                ax, ay, az, gx, gy, gz = values[:6]
                self.moving = abs(ax) + abs(ay) + abs(az - 9.8) > 2.0
                self.turning = abs(gz) > 35.0
        except ValueError:
            pass

    def _reader(self):
        while self.ser and self.ser.is_open:
            raw = self.ser.readline().decode(errors="ignore").strip()
            if raw:
                self.parse_line(raw)

class Speech:
    """Windows SAPI를 한 문장씩 실행한다. Korean은 EncodedCommand로 전달한다."""
    def __init__(self):
        self.jobs = queue.Queue(maxsize=1)
        self.last_time = 0.0
        threading.Thread(target=self._worker, daemon=True).start()

    def _worker(self):
        while True:
            text = self.jobs.get()
            try:
                ps = (
                    "Add-Type -AssemblyName System.Speech; "
                    "$s=New-Object System.Speech.Synthesis.SpeechSynthesizer; "
                    "$s.Volume=100; $s.Rate=1; $s.Speak(" + repr(text) + "); $s.Dispose()"
                )
                encoded = base64.b64encode(ps.encode("utf-16le")).decode("ascii")
                subprocess.run(
                    ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-EncodedCommand", encoded],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10
                )
            except Exception as exc:
                print("음성 출력 오류:", exc)
            finally:
                self.jobs.task_done()

    def say(self, key, text, force=False):
        now = time.time()
        if not force and now - self.last_time < 0.5:
            return
        self.last_time = now
        try:
            self.jobs.get_nowait()
            self.jobs.task_done()
        except queue.Empty:
            pass
        try:
            self.jobs.put_nowait(text)
        except queue.Full:
            pass


def label_of(result, cls_id):
    names = result.names
    return names[cls_id] if isinstance(names, (list, tuple)) else names.get(cls_id, "unknown")


def zone(x1, x2, width):
    center = (x1 + x2) / 2
    if center < width * 0.38:
        return "왼쪽"
    if center > width * 0.62:
        return "오른쪽"
    return "정면"


def roi(width, height):
    # 기존보다 가로를 조금 넓히고, 세로는 더 길게 잡는다.
    return int(width * 0.37), int(height * 0.12), int(width * 0.63), height


def in_walk_corridor(x1, x2, y1, y2, width, height):
    rx1, ry1, rx2, ry2 = roi(width, height)
    # 일반 사물도 ROI와 겹치면 안내한다. ROI보다 큰 박스도 포함한다.
    return not (x2 < rx1 or x1 > rx2 or y2 < ry1 or y1 > ry2)


def intersects_special_roi(x1, y1, x2, y2, width, height):
    rx1, ry1, rx2, ry2 = roi(width, height)
    return not (x2 < rx1 or x1 > rx2 or y2 < ry1 or y1 > ry2)


def special_is_near(x1, y1, x2, y2, width, height):
    """특수 상황은 멀리서 ROI 안에 작게 들어온 경우를 제외한다.
    ROI 경계를 넘거나, ROI와 비슷한 크기 이상일 때만 통과한다.
    """
    if not intersects_special_roi(x1, y1, x2, y2, width, height):
        return False
    rx1, ry1, rx2, ry2 = roi(width, height)
    fully_inside = x1 >= rx1 and y1 >= ry1 and x2 <= rx2 and y2 <= ry2
    box_area = max(1, (x2 - x1) * (y2 - y1))
    roi_area = max(1, (rx2 - rx1) * (ry2 - ry1))
    # 경계를 살짝이라도 넘거나 ROI의 약 45% 이상을 차지하면 가까운 것으로 본다.
    return (not fully_inside) or (box_area / roi_area >= 0.45)


def expanded_box(x1, y1, x2, y2, width, height, vertical_ratio=0.18):
    """표시 박스만 세로로 확장한다. 인식 결과 자체를 왜곡하지 않는다."""
    box_h = y2 - y1
    pad = int(box_h * vertical_ratio)
    return max(0, x1), max(0, y1 - pad), min(width - 1, x2), min(height - 1, y2 + pad)


def box_iou(a, b):
    _, _, ax1, ay1, ax2, ay2 = a
    _, _, bx1, by1, bx2, by2 = b
    ix1, iy1, ix2, iy2 = max(ax1,bx1), max(ay1,by1), min(ax2,bx2), min(ay2,by2)
    inter = max(0, ix2-ix1) * max(0, iy2-iy1)
    if inter == 0:
        return 0.0
    aa = max(1, (ax2-ax1)*(ay2-ay1)); ab = max(1, (bx2-bx1)*(by2-by1))
    return inter / (aa + ab - inter)


def component_belongs_to_door(component, doors, width, height):
    """손잡이는 중앙·고신뢰도·작은 물체일 때만 인정한다."""
    label, conf, cx1, cy1, cx2, cy2 = component
    center = (cx1 + cx2) / 2
    area_ratio = ((cx2-cx1) * (cy2-cy1)) / max(1, width * height)
    if conf < HANDLE_MIN_CONF or not width * 0.40 <= center <= width * 0.60 or area_ratio > 0.10:
        return False
    # 가까운 문은 화면 밖으로 잘려 손잡이만 보일 수 있으므로 허용한다.
    if not doors:
        # 문이 잘린 근거리 상황은 매우 높은 확신일 때만 허용한다.
        return conf >= 0.96
    for door in doors:
        _, _, x1, y1, x2, y2 = door
        if box_iou(component, door) > 0.01 or (x1-100 <= center <= x2+100 and y1-100 <= (cy1+cy2)/2 <= y2+100):
            return True
    return False


def korean_particle(word):
    """받침에 따라 이/가를 선택한다."""
    if not word:
        return "이"
    code = ord(word[-1])
    return "이" if 0xAC00 <= code <= 0xD7A3 and (code - 0xAC00) % 28 != 0 else "가"


def natural_object_sentence(position, label):
    ko = KOREAN_LABELS.get(label, label)
    return f"{position}에 {ko}{korean_particle(ko)} 있습니다."


def bbox_area(det):
    _, _, x1, y1, x2, y2 = det
    return max(1, (x2 - x1) * (y2 - y1))

class SituationMachine:
    def __init__(self):
        self.state = "WALK"
        self.forced = False
        self.candidate = None
        self.count = 0
        self.prev_frame = None
        self.stair_seen = False

    def set_forced(self, state):
        self.state = state
        self.forced = True

    def auto(self):
        self.forced = False

    def update(self, detections):
        labels = {d[0] for d in detections}
        if any(d[0] in DOOR_COMPONENT_LABELS for d in detections):
            labels.add("door")
        if self.forced:
            return self.state
        if labels & CROSSWALK_LABELS:
            candidate = "CROSSWALK"
        elif labels & STAIR_LABELS:
            candidate = "STAIRS"
        elif labels & DOOR_LABELS:
            candidate = "DOOR"
        else:
            candidate = "WALK"
        if candidate == self.candidate:
            self.count += 1
        else:
            self.candidate, self.count = candidate, 1
        # 특수 상황이 사라지면 이전 문/계단 상태를 즉시 종료한다.
        if candidate == "WALK":
            self.state = "WALK"
        elif self.count >= STATE_CONFIRM_FRAMES:
            self.state = candidate
        return self.state

    def door_motion(self, frame, door_det):
        """문 영역의 연속 프레임 변화량. 자동문 개폐를 확정하지 않고 변화만 감지."""
        if not door_det:
            self.prev_frame = None
            return 0.0
        _, _, x1, y1, x2, y2 = door_det
        crop = frame[max(0,y1):y2, max(0,x1):x2]
        if crop.size == 0:
            return 0.0
        gray = cv2.resize(cv2.cvtColor(crop, cv2.COLOR_BGR2GRAY), (160, 120))
        if self.prev_frame is None:
            self.prev_frame = gray
            return 0.0
        diff = float(np.mean(cv2.absdiff(self.prev_frame, gray)))
        self.prev_frame = gray
        return diff


def detection_priority(det, state, width, height):
    """현재 프레임에서 안내할 대상 하나만 선택한다.
    우선순위: 안내 영역 포함 여부 -> 화면 하단 위치(가까움 추정) -> 박스 크기 -> 중앙.
    실제 거리를 확정하지 않고 영상 내 상대 우선순위만 사용한다.
    """
    label, conf, x1, y1, x2, y2 = det
    rx1, ry1, rx2, ry2 = roi(width, height)
    inside = x1 >= rx1 and x2 <= rx2 and y1 >= ry1 and y2 <= ry2
    bottom = y2 / max(1, height)
    area = ((x2-x1) * (y2-y1)) / max(1, width*height)
    center = abs(((x1+x2)/2) - width/2) / max(1, width)
    # 특수 상황 상태에서는 특수 대상만 active에 남지만, 그 안에서도 하나만 선택한다.
    return (0 if inside else 1, -bottom, -area, center, -conf)


def main():
    print("YOLOE 모델 로딩 중...")
    model = YOLOE(MODEL_PATH)
    model.set_classes(PROMPTS)
    cap = cv2.VideoCapture(CAMERA_INDEX, cv2.CAP_DSHOW)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)
    if not cap.isOpened():
        raise RuntimeError("웹캠을 열 수 없습니다.")

    imu = OptionalIMU(IMU_PORT, IMU_BAUDRATE)
    speech = Speech()
    machine = SituationMachine()
    danger_candidate = None
    danger_count = 0
    track_history = {}
    last_stair_state = None

    while True:
        ok, frame = cap.read()
        if not ok:
            break
        h, w = frame.shape[:2]
        result = model.predict(frame, conf=CONFIDENCE, verbose=False)[0]
        all_dets = []
        for box in result.boxes:
            cls_id = int(box.cls[0])
            conf = float(box.conf[0])
            label = label_of(result, cls_id)
            x1, y1, x2, y2 = map(int, box.xyxy[0])
            all_dets.append((label, conf, x1, y1, x2, y2))

        # 인식은 항상 전체 PROMPTS 대상으로 유지한다.
        # 상태별 active는 '안내에 사용할 후보'만 고르는 용도다.
        # 문 안내 범위 밖의 문은 인식하되 안내 후보에서는 제외한다.
        # 냉장고·옷장·창문이 문으로 바뀌는 경우를 문 후보에서 제거한다.
        solid_objects = [d for d in all_dets if d[0] in {"refrigerator", "wardrobe", "closet", "window", "garage door"}
                         and in_walk_corridor(d[2], d[4], d[3], d[5], w, h)]
        raw_doors = [d for d in all_dets if d[0] in DOOR_LABELS
                     and d[1] >= (ELEVATOR_MIN_CONF if d[0] == "elevator door" else SPECIAL_MIN_CONF)
                     and special_is_near(d[2], d[3], d[4], d[5], w, h)]
        doors = [d for d in raw_doors if not any(box_iou(d, obj) > 0.12 for obj in solid_objects if obj[0] in {"refrigerator", "wardrobe", "window"})]
        components = [d for d in all_dets if d[0] in DOOR_COMPONENT_LABELS and d[1] >= HANDLE_MIN_CONF]
        valid_components = [d for d in components if component_belongs_to_door(d, doors, w, h)]
        # 중앙의 유효한 문/손잡이만 상태 전환에 사용한다.
        # 냉장고와 함께 잘못 검출된 문 라벨은 상태 전환에서도 제외한다.
        rejected_doors = [d for d in raw_doors if d not in doors]
        context_dets = [d for d in all_dets
                        if ((d[0] in DOOR_LABELS | STAIR_LABELS | CROSSWALK_LABELS
                             and special_is_near(d[2], d[3], d[4], d[5], w, h))
                            or (d[0] not in DOOR_LABELS | STAIR_LABELS | CROSSWALK_LABELS
                                and in_walk_corridor(d[2], d[4], d[3], d[5], w, h)))
                        and d not in rejected_doors]
        # 가까운 문이 화면 밖으로 잘려 손잡이만 보이는 경우도 문 상태로 전환한다.
        context_dets.extend(valid_components)
        state = machine.update(context_dets)
        # 테스트 단계: ROI와 상태별 필터를 끄고, 검출된 모든 대상을 안내 후보로 사용한다.
        # 차량도 포함하되, 한 프레임에서 한 문장으로 묶어 음성이 겹치지 않게 한다.
        active = [d for d in all_dets if d[1] >= CONFIDENCE]

        active.sort(key=lambda d: detection_priority(d, state, w, h))
        primary = active[0] if active else None
        # active는 우선순위 정렬 후 첫 번째 하나만 사용한다.
        active = [primary] if primary is not None else []
        # 대상이 바뀌거나 사라지면 이전 대상의 연속 카운트를 즉시 초기화한다.
        current_key = f"{primary[0]}_{zone(primary[2], primary[4], w)}" if primary else None
        if current_key != danger_candidate:
            danger_candidate = current_key
            danger_count = 1 if current_key else 0

        # 상태별 서브모듈
        if state == "WALK" and active:
            # 현재 검출된 대상을 한 문장으로 묶어 한 번만 출력한다.
            items = []
            seen = set()
            for item in active:
                label, _, x1, y1, x2, y2 = item
                ko = KOREAN_LABELS.get(label, label)
                pos = zone(x1, x2, w)
                token = (pos, ko)
                if token not in seen:
                    seen.add(token)
                    items.append(f"{pos} {ko}")
            if items:
                speech.say("all_objects", ", ".join(items) + ".")

        elif state == "DOOR" and primary:
            label, conf, x1, y1, x2, y2 = primary
            if label in HANDLE_LABELS and label in {d[0] for d in valid_components}:
                speech.say("handle_" + label, f"{zone(x1, x2, w)} 손잡이입니다. 당기거나 미세요.")
            elif label == "push bar" and label in {d[0] for d in valid_components}:
                speech.say("push_bar", "푸시바입니다. 앞으로 미세요.")
            elif label in DOOR_LABELS:
                # 회전문 프롬프트는 제거했다. 유리 미닫이문은 별도 유형으로만 제한한다.
                if label == "sliding glass door":
                    spoken_label = "sliding door" if conf >= 0.58 else "door"
                elif label == "sliding door" and conf < 0.58:
                    spoken_label = "door"
                else:
                    spoken_label = label
                text = DOOR_GUIDANCE.get(spoken_label, "문이 있습니다. 여는 방법을 확인하세요.")
                speech.say("door_" + spoken_label, f"{zone(x1, x2, w)}에 {text}")

        elif state == "STAIRS" and primary:
            # 시작/끝을 완전 확정하지 않고 상태 변화로 안내
            label, _, x1, y1, x2, y2 = primary
            stair_state = "접근"
            if y2 < h * 0.70:
                stair_state = "끝 가능성"
            if stair_state != last_stair_state:
                if stair_state == "접근":
                    speech.say("stairs_start", "계단 시작입니다. 천천히 가세요.")
                else:
                    speech.say("stairs_end", "계단 끝입니다. 평지를 확인하세요.")
                last_stair_state = stair_state

        elif state == "CROSSWALK":
            speech.say("crosswalk", "횡단보도입니다. 멈추세요.")
            vehicles = [d for d in all_dets if d[0] in VEHICLE_LABELS]
            for car in vehicles:
                label, _, x1, y1, x2, y2 = car
                pos = zone(x1, x2, w)
                center = ((x1+x2)/2, (y1+y2)/2)
                key = f"car_{pos}"
                previous = track_history.get(key)
                current_area = bbox_area(car)
                approaching = previous is not None and current_area > previous * 1.10
                track_history[key] = current_area
                if approaching:
                    if pos == "왼쪽":
                        speech.say("vehicle_left", "왼쪽에 차량이 있습니다. 기다리세요.")
                    elif pos == "오른쪽":
                        speech.say("vehicle_right", "오른쪽에 차량이 있습니다. 기다리세요.")
                    else:
                        speech.say("wait", "차량이 접근합니다. 기다리세요.")

        # 화면에는 항상 전체 인식 결과를 표시한다.
        # active는 안내용 후보일 뿐이며, 상태가 바뀌어도 다른 물체 인식을 끄지 않는다.
        rx1, ry1, rx2, ry2 = roi(w, h)
        cv2.rectangle(frame, (rx1, ry1), (rx2, ry2), (0,180,255), 2)
        for d in all_dets:
            label, conf, x1, y1, x2, y2 = d
            dx1, dy1, dx2, dy2 = expanded_box(x1, y1, x2, y2, w, h)
            if label in DOOR_LABELS:
                color = (0, 180, 255)
            elif label in DOOR_COMPONENT_LABELS:
                color = (255, 180, 0)
            elif label in STAIR_LABELS | CROSSWALK_LABELS:
                color = (180, 0, 255)
            else:
                color = (0, 0, 255) if d in active else (100, 180, 100)
            cv2.rectangle(frame, (dx1,dy1), (dx2,dy2), color, 2)
            cv2.putText(frame, f"{label} {conf:.2f}", (dx1,max(25,dy1-8)),
                        cv2.FONT_HERSHEY_SIMPLEX, .55, color, 2)
        imu_text = f"IMU moving={imu.moving} turning={imu.turning}"
        cv2.putText(frame, f"STATE: {state} | A:auto 1:walk 2:door 3:stairs 4:crosswalk Q:quit",
                    (15, 30), cv2.FONT_HERSHEY_SIMPLEX, .58, (255,255,255), 2)
        cv2.putText(frame, imu_text, (15, 58), cv2.FONT_HERSHEY_SIMPLEX, .55, (255,255,255), 2)
        cv2.imshow("YOLOE Situation-based Walking Assistant", frame)

        key = cv2.waitKey(1) & 0xFF
        if key == ord("q"):
            break
        if key == ord("a"):
            machine.auto()
        elif key == ord("1"):
            machine.set_forced("WALK")
        elif key == ord("2"):
            machine.set_forced("DOOR")
        elif key == ord("3"):
            machine.set_forced("STAIRS")
        elif key == ord("4"):
            machine.set_forced("CROSSWALK")

    cap.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    main()
