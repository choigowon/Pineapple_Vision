from ultralytics import YOLOE
import cv2
import time


# ============================================================
# 1. 설정
# ============================================================

MODEL_PATH = "yoloe_custom.pt"

# 0 = 노트북 웹캠
# 1 = USB 카메라
CAMERA_INDEX = 1

# YOLOE
CONF_THRESHOLD = 0.25
IMAGE_SIZE = 416

# 카메라 수평 시야각
HORIZONTAL_FOV = 120.0


# ============================================================
# 2. YOLOE 모델 불러오기
# ============================================================

print("YOLOE 모델을 불러오는 중...")

model = YOLOE(MODEL_PATH)

print("YOLOE 모델 로드 완료")


# ============================================================
# 3. USB 카메라 연결
# ============================================================

print(
    f"USB 카메라 연결: index={CAMERA_INDEX}"
)

cap = cv2.VideoCapture(
    CAMERA_INDEX
)

if not cap.isOpened():

    print(
        "❌ 카메라를 열 수 없습니다."
    )

    exit()


# ============================================================
# 4. 카메라 해상도
# ============================================================

cap.set(
    cv2.CAP_PROP_FRAME_WIDTH,
    640
)

cap.set(
    cv2.CAP_PROP_FRAME_HEIGHT,
    480
)


# ============================================================
# 5. 카메라 정보
# ============================================================

frame_width = int(
    cap.get(
        cv2.CAP_PROP_FRAME_WIDTH
    )
)

frame_height = int(
    cap.get(
        cv2.CAP_PROP_FRAME_HEIGHT
    )
)

print(
    f"카메라 해상도: "
    f"{frame_width} x "
    f"{frame_height}"
)


# ============================================================
# 6. 위치 판단
# ============================================================

def get_position(
    center_x,
    frame_width
):

    ratio = (
        center_x /
        frame_width
    )

    if ratio < 0.33:

        return "LEFT"

    elif ratio < 0.66:

        return "CENTER"

    else:

        return "RIGHT"


# ============================================================
# 7. 화면 점유율
# ============================================================

def get_area_ratio(
    x1,
    y1,
    x2,
    y2,
    frame_width,
    frame_height
):

    box_width = (
        x2 - x1
    )

    box_height = (
        y2 - y1
    )

    box_area = (
        box_width *
        box_height
    )

    frame_area = (
        frame_width *
        frame_height
    )

    if frame_area <= 0:

        return 0.0

    return (
        box_area /
        frame_area
    )


# ============================================================
# 8. 수평 방향각
# ============================================================

def get_horizontal_angle(
    center_x,
    frame_width,
    horizontal_fov
):

    normalized_x = (

        center_x -
        frame_width / 2

    ) / (

        frame_width / 2

    )

    angle = (

        normalized_x *
        (horizontal_fov / 2)

    )

    return angle


# ============================================================
# 9. 방향
# ============================================================

def get_direction(
    angle
):

    if angle < -20:

        return "LEFT"

    elif angle > 20:

        return "RIGHT"

    else:

        return "CENTER"


# ============================================================
# 10. 화면 안쪽으로 텍스트 위치 조정
# ============================================================

def draw_label(
    frame,
    text,
    x,
    y,
    color=(0, 255, 0)
):

    # OpenCV 폰트
    font = cv2.FONT_HERSHEY_SIMPLEX

    font_scale = 0.55

    thickness = 2

    # 텍스트 크기 계산
    (text_width, text_height), baseline = (

        cv2.getTextSize(

            text,

            font,

            font_scale,

            thickness

        )

    )


    # ========================================================
    # X 좌표 보정
    # ========================================================

    # 오른쪽 화면 밖으로 나가는 경우
    if (
        x + text_width
        > frame.shape[1]
    ):

        x = (
            frame.shape[1]
            - text_width
            - 5
        )


    # 왼쪽 화면 밖으로 나가는 경우
    if x < 5:

        x = 5


    # ========================================================
    # Y 좌표 보정
    # ========================================================

    # 텍스트가 화면 위로 나가는 경우
    if y - text_height < 0:

        # 아래쪽으로 이동
        y = (
            y +
            text_height +
            10
        )


    # 화면 아래쪽으로 나가는 경우
    if (
        y + baseline
        > frame.shape[0]
    ):

        y = (
            frame.shape[0]
            - baseline
            - 5
        )


    # ========================================================
    # 배경 박스
    # ========================================================

    cv2.rectangle(

        frame,

        (
            x - 3,
            y - text_height - 3
        ),

        (
            x + text_width + 3,
            y + baseline + 3
        ),

        (0, 0, 0),

        -1

    )


    # ========================================================
    # 텍스트
    # ========================================================

    cv2.putText(

        frame,

        text,

        (
            x,
            y
        ),

        font,

        font_scale,

        color,

        thickness,

        cv2.LINE_AA

    )


# ============================================================
# 11. FPS
# ============================================================

prev_time = time.time()


# ============================================================
# 12. 메인 루프
# ============================================================

print()
print(
    "======================================"
)

print(
    "YOLOE + USB 광각 카메라 시작"
)

print(
    "======================================"
)

print(
    "종료: Q"
)

print()


while True:


    # ========================================================
    # 카메라 읽기
    # ========================================================

    ret, frame = (
        cap.read()
    )


    if not ret:

        print(
            "❌ 카메라 프레임을 "
            "읽을 수 없습니다."
        )

        break


    # ========================================================
    # 프레임 크기
    # ========================================================

    frame_height, frame_width = (
        frame.shape[:2]
    )


    # ========================================================
    # YOLOE 추론
    # ========================================================

    results = model.predict(

        source=frame,

        conf=CONF_THRESHOLD,

        imgsz=IMAGE_SIZE,

        verbose=False

    )


    result = results[0]


    # ========================================================
    # 객체 처리
    # ========================================================

    for box in result.boxes:


        # ====================================================
        # 클래스
        # ====================================================

        cls_id = int(
            box.cls[0]
        )

        class_name = (
            result.names[
                cls_id
            ]
        )


        # ====================================================
        # Confidence
        # ====================================================

        confidence = float(
            box.conf[0]
        )


        # ====================================================
        # Bounding Box
        # ====================================================

        x1, y1, x2, y2 = map(

            int,

            box.xyxy[0].tolist()

        )


        # ====================================================
        # 좌표 안전성 보정
        # ====================================================

        x1 = max(
            0,
            min(
                x1,
                frame_width - 1
            )
        )

        y1 = max(
            0,
            min(
                y1,
                frame_height - 1
            )
        )

        x2 = max(
            0,
            min(
                x2,
                frame_width - 1
            )
        )

        y2 = max(
            0,
            min(
                y2,
                frame_height - 1
            )
        )


        # ====================================================
        # 중심점
        # ====================================================

        center_x = (
            x1 + x2
        ) / 2


        # ====================================================
        # 방향
        # ====================================================

        position = (
            get_position(

                center_x,

                frame_width

            )
        )


        # ====================================================
        # Area
        # ====================================================

        area_ratio = (

            get_area_ratio(

                x1,
                y1,
                x2,
                y2,

                frame_width,
                frame_height

            )

        )


        # ====================================================
        # Angle
        # ====================================================

        angle = (

            get_horizontal_angle(

                center_x,

                frame_width,

                HORIZONTAL_FOV

            )

        )


        # ====================================================
        # Direction
        # ====================================================

        direction = (

            get_direction(

                angle

            )

        )


        # ====================================================
        # Bounding Box
        # ====================================================

        cv2.rectangle(

            frame,

            (
                x1,
                y1
            ),

            (
                x2,
                y2
            ),

            (0, 255, 0),

            2

        )


        # ====================================================
        # 객체 이름
        # ====================================================

        label_text = (

            f"{class_name} "
            f"{confidence:.2f}"

        )


        # ====================================================
        # 객체 이름 표시
        # ====================================================

        draw_label(

            frame,

            label_text,

            x1,

            y1 - 5,

            (0, 255, 0)

        )


        # ====================================================
        # 상세 정보
        # ====================================================

        info_text = (

            f"{direction} "
            f"{angle:+.0f}deg "
            f"Area:{area_ratio:.2f}"

        )


        # ====================================================
        # 상세 정보 표시
        # ====================================================

        draw_label(

            frame,

            info_text,

            x1,

            y2 + 20,

            (0, 255, 255)

        )


        # ====================================================
        # 터미널 출력
        # ====================================================

        print(

            f"[{class_name}] "

            f"Conf={confidence:.2f} | "

            f"Direction={direction} | "

            f"Angle={angle:+.1f}° | "

            f"Area={area_ratio:.2f}"

        )


    # ========================================================
    # 중앙 기준선
    # ========================================================

    cv2.line(

        frame,

        (
            frame_width // 2,
            0
        ),

        (
            frame_width // 2,
            frame_height
        ),

        (255, 0, 0),

        2

    )


    # ========================================================
    # FPS 계산
    # ========================================================

    current_time = time.time()

    fps = (

        1 /
        max(
            current_time -
            prev_time,

            0.0001

        )

    )

    prev_time = current_time


    # ========================================================
    # FPS 표시
    # ========================================================

    draw_label(

        frame,

        f"FPS: {fps:.1f}",

        10,

        30,

        (0, 255, 255)

    )


    # ========================================================
    # 화면 출력
    # ========================================================

    cv2.imshow(

        "YOLOE - USB Wide Angle Camera",

        frame

    )


    # ========================================================
    # Q 종료
    # ========================================================

    key = (

        cv2.waitKey(1)
        & 0xFF

    )


    if key == ord("q"):

        break


# ============================================================
# 13. 종료
# ============================================================

cap.release()

cv2.destroyAllWindows()

print()
print(
    "프로그램 종료"
)
